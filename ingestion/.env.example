# Copy this file to ".env" in the same folder and fill in your real values.
# NEVER commit the real ".env" file to git (it's already in .gitignore).

# Cloudflare account ID (find it on the right sidebar of any page in the
# Cloudflare dashboard, or run: wrangler whoami)
CLOUDFLARE_ACCOUNT_ID=your-account-id-here

# API token with "Workers AI: Edit", "Vectorize: Edit" and "D1: Edit" permissions
# (create one at https://dash.cloudflare.com/profile/api-tokens)
CLOUDFLARE_API_TOKEN=your-api-token-here

# Must match the index_name in worker/wrangler.jsonc
VECTORIZE_INDEX_NAME=rag-pdf-index

# The Database ID printed by `wrangler d1 create rag-pdf-db`
D1_DATABASE_ID=your-d1-database-id-here
